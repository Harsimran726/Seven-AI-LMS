rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email in ['harsimransingh27448@gmail.com', 'harsimransd726@gmail.com'] ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isApprovedStaff() {
      return isVerified() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)) 
         && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'approved';
    }

    function hasAccess() {
      return isAdmin() || isApprovedStaff();
    }

    // --- Staff & Admin Access Directory ---
    match /staff/{staffId} {
      allow get: if isVerified();
      allow list: if hasAccess();
      allow create: if isVerified() && (isAdmin() || request.auth.uid == staffId);
      allow update: if isVerified() && (isAdmin() || request.auth.uid == staffId);
      allow delete: if isAdmin();
    }

    // --- Students Rules ---
    match /students/{studentId} {
      allow get, list: if hasAccess();
      allow create, update, delete: if hasAccess();
    }

    // --- Transactions Rules ---
    match /transactions/{transactionId} {
      allow get, list, create, update, delete: if hasAccess();
    }

    // --- Attendances Rules ---
    match /attendances/{attendanceId} {
      allow get, list, create, update, delete: if hasAccess();
    }

    // --- Expenses Rules ---
    match /expenses/{expenseId} {
      allow get, list, create, update, delete: if hasAccess();
    }

    // --- Batches Rules ---
    match /batches/{batchId} {
      allow get, list, create, update, delete: if hasAccess();
    }

    // --- Leads Rules ---
    match /leads/{leadId} {
      allow get, list, create, update, delete: if hasAccess();
    }

    // --- Office Earnings Rules ---
    match /office_earnings/{earningId} {
      allow get, list, create, update, delete: if hasAccess();
    }
  }
}
